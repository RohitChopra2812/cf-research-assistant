{
  "name": "cf-research-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create research-assistant-db",
    "db:migrate": "wrangler d1 execute research-assistant-db --file schema.sql",
    "db:migrate:remote": "wrangler d1 execute research-assistant-db --remote --file schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.100.0"
  }
}
